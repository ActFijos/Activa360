# --- variante chatgpt/ -----------------------------------------------------
CHATGPT_API_KEY=tu_api_key_de_openai
CHATGPT_MODEL=gpt-4o-mini
CHATGPT_EMBED_BACKEND=openai          # openai | chroma
CHATGPT_EMBED_MODEL=text-embedding-3-small

# --- variante localhost/ ---------------------------------------------------
LOCALIA_BASE_URL=http://localhost:3000/api
LOCALIA_API_KEY=tu_api_key_de_localia
LOCALIA_MODEL=llama3.1:latest
LOCALHOST_EMBED_BACKEND=chroma        # chroma | ollama
LOCALHOST_EMBED_MODEL=nomic-embed-text

# --- agente ----------------------------------------------------------------
MAX_PASOS=6
TOP_K=3

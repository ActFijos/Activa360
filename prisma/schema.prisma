datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Modelo de Bajas SABS (Módulo Compliance)
model Baja {
  id            String   @id @default(uuid())
  assetId       String   @unique
  diagnosticoId String?
  jefeId        String
  justification String
  evidence      String
  initiatedAt   DateTime @default(now())
  status        String   @default("Iniciada")
  motivoRechazo String?
}

// Modelo de Activo Fijo (Módulo Inventario)
model Asset {
  id              String   @id @default(uuid())
  qrCode          String   @unique
  name            String   // Descripción detallada, marca, modelo, serie
  status          String   // Nuevo, Asignado, Dañado, Obsoleto, etc.
  location        String
  updatedAt       DateTime @updatedAt

  // Campos adicionales Datos del Activo (image3.png)
  category        String
  usefulLife      Int?     // Opcional en el mockup
  origin          String   // Compra, Donación, etc.
  purchaseDate    DateTime
  entryDate       DateTime // Fecha de ingreso Unidad/Almacén
  purchaseValue   Float    // Valor de adquisición ($us)
  warrantyMonths  Int?     // Opcional en el mockup

  // Datos del Proveedor (Paso 2)
  providerName    String?
  providerNit     String?
  providerPhone   String?

  movements       Movement[]
  maintenances    MaintenanceReport[]
  transfers       Transfer[]
  diagnosticos    DiagnosticoTecnico[]
  statusHistory   AssetStatusHistory[]
}

// Modelo de Geolocalización y Escaneo (Historial de ubicaciones)
model Movement {
  id        String   @id @default(uuid())
  assetId   String
  latitude  Float
  longitude Float
  scannedAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// Modelo de Transferencias de Activos
model Transfer {
  id              String   @id @default(uuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id])
  fromUnit        String
  fromResponsible String
  toUnit          String
  toResponsible   String
  date            DateTime @default(now())
  status          String   // Aprobada, Pendiente, Rechazada
  reason          String
}

// Modelo de Asignaciones de Activos a responsables
model Assignment {
  id           String   @id @default(uuid())
  assetId      String
  responsible  String
  date         DateTime @default(now())
  destination  String
  observations String?
}

// Modelo de Usuarios del Sistema local
model User {
  id       String  @id @default(uuid())
  fullName String
  ci       String  @unique
  phone    String
  role     String  // Administrador, Supervisor, Inventariador
  username String  @unique
  cargo    String? // Cargo del usuario (Ej: Administrador de Sistemas)
  password String? // Contraseña del usuario
}

model MaintenanceReport {
  id            String   @id @default(uuid())
  assetId       String
  diagnosis     String   // Detalle técnico de la falla
  estimatedCost Float    // Costo estimado de reparación
  action        String   // "Reparar" o "Recomendar_Baja"
  inspectedAt   DateTime @default(now())
  
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// Modelo de Auditoría de Conversaciones con IA
model AiConversation {
  id             String   @id @default(uuid())
  usuarioId      String   @map("usuario_id")
  pregunta       String
  respuesta      String
  toolUtilizada  String?  @map("tool_utilizada")
  parametrosTool String?  @map("parametros_tool")
  fecha          DateTime @default(now())
  duracion       Int      // Duración en milisegundos

  @@map("AI_CONVERSATIONS")
}

// --- Feature 1: Inventario QR con control de concurrencia ---

// Modelo de Campaña de Inventario Físico
model InventoryCampaign {
  id        String            @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime          @default(now())
  records   InventoryRecord[]

  @@map("inventory_campaigns")
}

// Modelo de Registro de Inventario QR
// La restricción @@unique garantiza que no puedan existir dos registros
// del mismo activo dentro de la misma campaña, incluso con solicitudes concurrentes.
model InventoryRecord {
  id         String          @id @default(uuid())
  campaignId String
  assetId    String
  userId     String
  createdAt  DateTime        @default(now())
  campaign   InventoryCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, assetId])
  @@map("inventory_records")
}

// Modelo de Diagnóstico Técnico Previo a Baja SABS
model DiagnosticoTecnico {
  id                      String    @id @default(uuid())
  numeroInforme           String    @unique // ej. INF-TEC-2026-001
  assetId                 String
  tecnicoId               String?
  tecnicoNombre           String?
  causalSabs              String    // OBSOLESCENCIA, DETERIORO_IRREPARABLE, SINIESTRO, INCOMPATIBILIDAD_TECNICA, HURTO_O_ROBO
  diagnosticoDetalle      String    // Detalle técnico de la inspección/falla
  recomendacion           String    // RECOMENDAR_BAJA, REPARAR, REASIGNAR
  dictaminaBaja           Boolean   @default(true)
  evidenciaDocumento      String?   // URL o identificador del documento de evidencia
  costoEstimadoReparacion Float?    @default(0)
  estado                  String    @default("VIGENTE") // VIGENTE, UTILIZADO_EN_BAJA, RESTAURADO, ANULADO
  fechaEmision            DateTime  @default(now())
  observaciones           String?

  asset                   Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([estado])
  @@map("diagnosticos_tecnicos")
}

// Modelo de Trazabilidad e Historial de Cambios de Estado Patrimoniales SABS
model AssetStatusHistory {
  id             String   @id @default(uuid())
  assetId        String
  previousStatus String
  newStatus      String
  reason         String?
  changedBy      String?
  changedAt      DateTime @default(now())

  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_status_history")
}


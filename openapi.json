    "/inventory/scan": {
      "post": {
        "description": "Persiste el registro de un activo escaneado dentro de una campaña. Garantiza que dos escaneos concurrentes del mismo activo en la misma campaña no generan duplicados (restricción UNIQUE en PostgreSQL). Caso de uso FSD: UC-INV-001.",
        "operationId": "InventoryScanController_registerScan",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInventoryScanDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Activo registrado correctamente en el inventario de la campaña.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Activo registrado en el inventario correctamente.",
                    "record": {
                      "id": "uuid-v4",
                      "campaignId": "camp-2026-q4",
                      "assetId": "asset-abc-123",
                      "userId": "user-xyz-789",
                      "createdAt": "2026-10-22T20:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflicto — el activo ya fue registrado en esta campaña (duplicado rechazado).",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "statusCode": 409,
                    "message": "El activo asset-abc-123 ya fue registrado en la campaña camp-2026-q4.",
                    "error": "Conflict"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Datos de entrada inválidos."
          }
        },
        "summary": "Registrar escaneo QR de activo en campaña de inventario",
        "tags": [
          "inventario"
        ]
      }
    },

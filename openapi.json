    "/bajas": {
      "post": {
        "operationId": "InitiateBajaController_initiateBaja",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateBajaDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trámite de baja iniciado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BajaItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos del trámite inválidos"
          },
          "404": {
            "description": "El activo no existe en el inventario"
          },
          "409": {
            "description": "El activo no se encuentra en estado Dañado/Obsoleto o ya tiene baja iniciada"
          }
        },
        "summary": "Iniciar un nuevo trámite de baja SABS para un activo dañado u obsoleto",
        "tags": [
          "compliance"
        ]
      },
      "get": {
        "operationId": "InitiateBajaController_getBajas",
        "parameters": [
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "description": "Filtrar por estado del trámite de baja",
            "schema": {
              "example": "INICIADA",
              "type": "string",
              "enum": [
                "INICIADA",
                "APROBADA",
                "RECHAZADA"
              ]
            }
          },
          {
            "name": "activo",
            "required": false,
            "in": "query",
            "description": "Filtrar por ID, código QR o nombre del activo (búsqueda insensible a mayúsculas)",
            "schema": {
              "example": "ACT-UMSS-2026-0001",
              "type": "string"
            }
          },
          {
            "name": "fechaDesde",
            "required": false,
            "in": "query",
            "description": "Fecha inicial del rango de registro de la baja (ISO 8601)",
            "schema": {
              "example": "2026-01-01T00:00:00.000Z",
              "type": "string"
            }
          },
          {
            "name": "fechaHasta",
            "required": false,
            "in": "query",
            "description": "Fecha final del rango de registro de la baja (ISO 8601)",
            "schema": {
              "example": "2026-12-31T23:59:59.999Z",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número de página para paginación (comenzando en 1)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Cantidad máxima de registros por página",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado de bajas con metadatos total, page, limit y totalPages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedBajasResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de consulta o fechas inválidas"
          }
        },
        "summary": "Listar trámites de bajas con filtros por estado, activo y rango de fechas, más paginación",
        "tags": [
          "compliance"
        ]
      }
    },
    "/bajas/{id}/aprobar": {
      "post": {

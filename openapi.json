            "enum": [
              "Iniciada",
              "APROBADA",
              "RECHAZADA"
            ],
            "description": "Estado actual del trámite"
          },
          "motivoRechazo": {
            "type": "object",
            "example": null,
            "nullable": true,
            "description": "Motivo de rechazo registrado si el estado es RECHAZADA"
          }
        },
        "required": [
          "id",
          "assetId",
          "jefeId",
          "justification",
          "evidence",
          "initiatedAt",
          "status",
          "motivoRechazo"

      "BajaItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "baja-uuid-1",
            "description": "ID único del trámite de baja"
          },
          "assetId": {
            "type": "string",
            "example": "asset-uuid-1",
            "description": "ID del activo vinculado"
          },
          "jefeId": {
            "type": "string",
            "example": "jefe-uuid-1",
            "description": "ID del jefe o supervisor autorizador"
          },
          "justification": {
            "type": "string",
            "example": "Equipo obsoleto no actualizable",
            "description": "Justificación contable de la baja"
          },
          "evidence": {
            "type": "string",
            "example": "ACTA-2026-001",
            "description": "Referencia a la evidencia o acta física de soporte"
          },

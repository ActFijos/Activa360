    "/activos/transferir": {
      "post": {
        "description": "Inicia una transferencia de activo con bloqueo pesimista (SELECT FOR UPDATE) dentro de una transacción Prisma. Garantiza que dos solicitudes concurrentes para el mismo activo no generen transferencias duplicadas. Caso de uso FSD: UC-TRANS-001.",
        "operationId": "TransferAssetController_transferAsset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferAssetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transferencia creada en estado Pendiente.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "id": "uuid",
                    "assetId": "uuid",
                    "status": "Pendiente",
                    "toUnit": "Unidad B"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Activo no encontrado."
          },
          "409": {
            "description": "El activo está dado de baja o en proceso de baja."
          }
        },
        "summary": "Solicitar transferencia de activo entre unidades",
        "tags": [
          "activos"
        ]
      }
    },
